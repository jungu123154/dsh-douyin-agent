{
  "name": "dsh-douyin-browser-local",
  "version": "1.6.0",
  "type": "module",
  "description": "大肥鱼抖音助手：在 DSH 设置页里控制抖音的观看、私信、分享，并给任意作品点赞、收藏、评论与查看主页作品。",
  "license": "MIT",
  "author": "LockyBee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LockyBee/dsh-douyin-agent.git"
  },
